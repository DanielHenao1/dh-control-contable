# Copiar a .env y completar. NUNCA subir .env al repositorio.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=control.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://control.ejemplo.com
DATABASE_URL=postgres://control:cambiar@db:5432/control
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=cambiar
DOMINIO=control.ejemplo.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=control@ejemplo.com
ALERTAS_DESTINATARIOS=
# Asistente de IA (opcional): solo recibe hallazgos ya calculados
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-sonnet-5-5
# Copias de seguridad (S3 compatible)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_PASSPHRASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
